{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@joblog/tsconfig · base",
  "compilerOptions": {
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "incremental": true
  }
}
