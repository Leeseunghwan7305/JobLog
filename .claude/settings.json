{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm parse:eval)",
      "Bash(pnpm -r *)",
      "Bash(pnpm --filter * run *)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(pnpm --filter @joblog/api test)",
      "Bash(pnpm --filter @joblog/api typecheck)",
      "Bash(pnpm --filter @joblog/api parse:eval)",
      "Bash(pnpm --filter @joblog/api build)",
      "Bash(node --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\""
          }
        ]
      }
    ]
  }
}
