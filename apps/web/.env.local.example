# 이 파일을 복사해 apps/web/.env.local 로 만드세요.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_KAKAO_JS_KEY=""

# 공개 사이트 URL (OG/canonical/sitemap 절대경로용). 배포 시 실제 도메인으로.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 관측/분석 (모두 선택값: 비우면 해당 기능이 조용히 꺼짐) ──
# Sentry 에러·성능 모니터링. DSN이 비어 있으면 Sentry가 비활성.
NEXT_PUBLIC_SENTRY_DSN=""
# 소스맵 업로드용(빌드타임 전용, 공개 금지). Vercel 환경변수로만 설정.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# GA4 측정 ID (예: G-XXXXXXXXXX). 비우면 GA 스크립트를 넣지 않음.
NEXT_PUBLIC_GA_ID=""
# Vercel Analytics·Speed Insights는 별도 키 불필요 (Vercel 배포 시 자동).
