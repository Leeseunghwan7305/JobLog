# 이 파일을 복사해 apps/api/.env 로 만들고 값을 채우세요.
DATABASE_URL="postgresql://joblog:joblog@localhost:5434/joblog?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"

# 어드민 허용목록 — 어드민으로 지정할 사용자의 kakaoId(쉼표 구분).
# 비어 있으면 아무도 어드민이 아니다(안전 기본값). 본인 kakaoId는 로그인 후 GET /auth/me 또는 DB User.kakaoId 로 확인.
ADMIN_KAKAO_IDS=""

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=""
KAKAO_REDIRECT_URI="http://localhost:4000/auth/kakao/callback"
# 카카오 콘솔 > 보안 > Client Secret 을 '사용함'으로 켠 경우만 입력
KAKAO_CLIENT_SECRET=""
# 카카오 '나에게 보내기' 리마인더: 콘솔에서 talk_message 동의항목을 켠 뒤 "on"으로 활성화.
# (비우면 로그인 scope에 영향 없음 — 안전 기본값)
KAKAO_TALK_MESSAGE=""

# Gmail 자동 상태감지(선택): Google Cloud > OAuth 클라이언트(웹) 자격증명.
# 리다이렉트 URI는 콘솔에 등록된 값과 정확히 일치해야 한다.
# 비워두면 Gmail 연결 기능이 비활성(로그인 등 다른 기능엔 영향 없음).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://joblog.duckdns.org/integrations/gmail/callback"

# LLM 프로바이더 라우팅: ollama(로컬) | groq(클라우드 무료) | anthropic(클라우드 유료) | none
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Groq (클라우드 무료 티어, OpenAI 호환) — 배포 시 LLM_PROVIDER=groq. console.groq.com 에서 발급
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# 선택 (anthropic 프로바이더/스크래핑용. 비어 있으면 붙여넣기 폴백)
ANTHROPIC_API_KEY=""
FIRECRAWL_API_KEY=""

# 공공데이터포털 국민연금 가입사업장 API 인증키 (회사 정보 패널). 없으면 지표 생략, 바로가기만 표시
NPS_API_KEY=""

# 개발자 문의하기 → Discord 웹훅 URL (Discord 채널 설정 > 연동 > 웹훅).
# 백엔드에서만 사용(프론트 노출 금지). 비어 있으면 /support가 503 반환.
DISCORD_WEBHOOK_URL=""

# 알림 (Resend). 키 없으면 메일 비활성(콘솔 로그 폴백)
RESEND_API_KEY=""
MAIL_FROM="JobLog <onboarding@resend.dev>"
APP_BASE_URL="http://localhost:3000"
NOTIFY_DAYS_AHEAD="3"
