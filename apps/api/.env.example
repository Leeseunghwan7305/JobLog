# 이 파일을 복사해 apps/api/.env 로 만들고 값을 채우세요.
DATABASE_URL="postgresql://joblog:joblog@localhost:5433/joblog?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=""
KAKAO_REDIRECT_URI="http://localhost:4000/auth/kakao/callback"

# 선택 (비어 있으면 공고 파싱은 붙여넣기 폴백으로 동작)
ANTHROPIC_API_KEY=""
FIRECRAWL_API_KEY=""
