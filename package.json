{
  "name": "joblog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parse:eval": "pnpm --filter @joblog/api parse:eval",
    "api": "pnpm --filter @joblog/api",
    "web": "pnpm --filter @joblog/web",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@joblog/prettier-config": "workspace:*",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.6.3"
  }
}
